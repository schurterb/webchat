{
  "Version": "2015-01-01",
  "Statement": [
    {
      "Sid": "ReadAccess",
      "Effect": "Allow",
      "Action": [ 
        "s3:GetObject", 
        "s3:ListBucket" 
      ],
      "Resource": [
        "arn:aws:s3:::web-chat-rooms-20210208",
        "arn:aws:s3:::web-chat-rooms-20210208/*"
      ]
    },
    {
      "Sid": "WriteAccess",
      "Effect": "Allow",
      "Action": [ 
        "s3:PutObject", 
        "s3:DeleteObject" 
      ],
      "Resource": "arn:aws:s3:::web-chat-rooms-20210208/${aws:userid}/*"
    }
  ]
}