# Initialize JS App
// Initialize the Amazon Cognito credentials provider with unauthenticated user
AWS.config.region = 'us-east-1'; // Region
AWS.config.credentials = new AWS.CognitoIdentityCredentials({
    IdentityPoolId: 'us-east-1:af776b5f-8a1c-4b16-b843-bdd854cf7257',
});

// Initialize the Amazon Cognito credentials provider with authenticated user
AWS.config.region = 'us-east-1'; // Region
AWS.config.credentials = new AWS.CognitoIdentityCredentials({
    IdentityPoolId: 'us-east-1:af776b5f-8a1c-4b16-b843-bdd854cf7257',
});